          },
          {
            "name": "Brandenburg fixed registered rate",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_district), REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\", bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"})",
            "formatString": "0.0000",
            "lineageTag": "6fd242ad-cd79-4d1d-b459-a9d32714365c"
          },
          {
            "name": "Brandenburg fixed hypothetical points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_district), REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\", bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"})",
            "formatString": "#,0",
            "lineageTag": "ac02bd18-1b2c-4ff5-aff8-c93debc5692b"
          },
          {
            "name": "Brandenburg fixed hypothetical residents",
            "expression": "CALCULATE([Population], REMOVEFILTERS(bi_district), REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\", bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"})",
            "formatString": "#,0",
            "lineageTag": "518cb813-3616-4974-b571-e5cad841416f"
          },
          {
            "name": "Brandenburg fixed hypothetical rate",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_district), REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\", bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"})",
            "formatString": "0.0000",
            "lineageTag": "cef0043d-8f23-4fea-a394-aca1fd08616e"
          },
          {
            "name": "Selected registered points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\", KEEPFILTERS(bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"}))",
            "formatString": "#,0",
            "lineageTag": "1b39fb5b-1a98-403a-ab24-5cdad1253bf2"
          },
          {
            "name": "Selected registered residents",
            "expression": "CALCULATE([Population], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\", KEEPFILTERS(bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"}))",
            "formatString": "#,0",
            "lineageTag": "b8f59618-27f2-46a8-862f-ffe4dc42e248"
          },
          {
            "name": "Selected registered rate",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\", KEEPFILTERS(bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"}))",
            "formatString": "0.0000",
            "lineageTag": "e7c90d46-dc41-47b2-ba5d-4703128e07e0"
          },
          {
            "name": "Brandenburg fixed title",
            "expression": "\"Brandenburg, all 18 districts (fixed) · \" & FORMAT([Brandenburg fixed registered points], \"#,0\") & \" points / \" & FORMAT([Brandenburg fixed registered residents], \"#,0\") & \" residents\"",
            "lineageTag": "1fe16f36-b108-4518-a9a8-416b1fd6797e"
          },
          {
            "name": "Berlin title",
            "expression": "\"Berlin, separate context (not ranked) · \" & FORMAT(CALCULATE([Berlin Registered or Scenario Points], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\"), \"#,0\") & \" points / \" & FORMAT([Berlin Population], \"#,0\") & \" residents\"",
            "lineageTag": "e8153cb0-5db7-4a07-b85d-224bfeb882f3"
          },
          {
            "name": "Berlin registered rate",
            "expression": "CALCULATE([Berlin Points per 10000 Residents], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "0.0000",
            "lineageTag": "02894236-3a65-4acb-a46f-63f4d12988df"
          },
          {
            "name": "Selected districts title",
            "expression": [
              "VAR names = CALCULATETABLE(VALUES(bi_district[district_name]), KEEPFILTERS(bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"}))",
              "VAR n = COUNTROWS(names)",
              "RETURN IF(n = 18, \"Selected: none, so all 18 districts\", \"Selected (\" & n & \"): \" & IF(n <= 3, CONCATENATEX(names, bi_district[district_name], \", \", bi_district[district_name], ASC), n & \" districts\")) & \" · \" & FORMAT([Selected registered points], \"#,0\") & \" points / \" & FORMAT([Selected registered residents], \"#,0\") & \" residents\""
            ],
            "lineageTag": "fc343760-3f40-488f-b3f4-6371d70fbc0c"
          },
          {
            "name": "Selected district code",
            "expression": "SELECTEDVALUE('District selector'[district_code])",
            "lineageTag": "2e9f21da-c94c-4dec-b6dd-ba6138c06b5e"
          },
          {
            "name": "District bar colour",
            "expression": "VAR code = [Selected district code] RETURN IF(SELECTEDVALUE(bi_district[district_code]) = IF(ISBLANK(code), \"12067\", code), \"#1D5FBF\", \"#A7B0BC\")",
            "lineageTag": "9b33ce5c-ff8a-468b-b816-15195fc3882a"
          },
          {
            "name": "Selected bar colour",
            "expression": "VAR code = [Selected district code] RETURN IF(NOT ISBLANK(code) && SELECTEDVALUE(bi_district[district_code]) = code, \"#1D5FBF\", \"#A7B0BC\")",
            "lineageTag": "13811a92-5cc3-4374-b0a9-229ce2479b5a"
          },
          {
            "name": "Selected row colour",
            "expression": "VAR code = [Selected district code] RETURN IF(NOT ISBLANK(code) && SELECTEDVALUE(bi_district[district_code]) = code, \"#DCE8F8\")",
            "lineageTag": "73ac2978-d8f5-4c33-953f-e606a453d584"
          },
          {
            "name": "Scenario bar colour",
            "expression": "IF(SELECTEDVALUE(bi_scenario[scenario_id]) = \"registered\", \"#1D5FBF\", \"#9DBFEA\")",
            "lineageTag": "b2192500-c2f0-49e2-8c03-f867d9cda47c"
          },
          {
            "name": "Registered unresolved points (non-zero)",
            "expression": "VAR v = CALCULATE([Unresolved known points], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\") RETURN IF(v <> 0, v)",
            "formatString": "#,0",
            "lineageTag": "d5ab5c95-32c0-43ef-b802-7c44f85766b3"
          },
          {
            "name": "Oder-Spree rate change",
            "expression": "FORMAT(CALCULATE([Registered rate], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"0.0\") & \" → \" & FORMAT(CALCULATE([Hypothetical rate], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"0.0\")",
            "lineageTag": "710fba5b-829e-4c5e-8b3e-13fcaa48e1c9"
          },
          {
            "name": "Oder-Spree rank change",
            "expression": "FORMAT(CALCULATE([Registered rank], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"0\") & \" → \" & FORMAT(CALCULATE([Hypothetical rank], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"0\")",
            "lineageTag": "f623c30e-f4f0-43a1-9fc0-9a6119a4c7d1"
          },
          {
            "name": "Oder-Spree title",
            "expression": "\"Oder-Spree · \" & FORMAT(CALCULATE([Registered points], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"#,0\") & \" → \" & FORMAT(CALCULATE([Hypothetical points], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"#,0\") & \" points · \" & FORMAT(CALCULATE([Population], REMOVEFILTERS(bi_district), bi_district[district_code] = \"12067\"), \"#,0\") & \" residents\"",
            "lineageTag": "776e5227-12cd-412a-88fd-a072ec536610"
          },
          {
            "name": "Brandenburg rate change",
            "expression": "FORMAT([Brandenburg fixed registered rate], \"0.0\") & \" → \" & FORMAT([Brandenburg fixed hypothetical rate], \"0.0\")",
            "lineageTag": "0c5a5cc0-6cf0-4a4a-8e17-02a6a8984af7"
          },
          {
            "name": "Brandenburg change title",
            "expression": "\"Brandenburg, all 18 districts · \" & FORMAT([Brandenburg fixed registered points], \"#,0\") & \" → \" & FORMAT([Brandenburg fixed hypothetical points], \"#,0\") & \" points\"",
            "lineageTag": "c30491a6-d444-4312-b555-6adf12c87340"
          },
          {
            "name": "Registered installations",
            "expression": "CALCULATE([Installations], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "#,0",
            "lineageTag": "157587d6-fc7c-46c4-9e1c-4eb33ead32df"
          },
          {
            "name": "Registered capacity kW",
            "expression": "CALCULATE([Installation kW], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "#,0.0",
            "lineageTag": "37b967d9-41f7-4cf8-8aa8-00e5b9166cb3"
          },
          {
            "name": "Registered capacity MW",
            "expression": "DIVIDE([Registered capacity kW], 1000)",
            "formatString": "#,0.0",
            "lineageTag": "869c141f-ffd2-430c-bcce-bb55ef0d122d"
          },
          {
            "name": "Registered points per installation",
            "expression": "DIVIDE([Registered points], [Registered installations] - CALCULATE([Unknown point installations], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\"))",
            "formatString": "0.00",
            "lineageTag": "d68e71be-a70f-4977-be58-5c806c42ca3b"
          },
          {
            "name": "Selected district compare",
            "expression": [
              "VAR code = [Selected district code]",
              "VAR districtName = SELECTEDVALUE('District selector'[District])",
              "RETURN IF(ISBLANK(code), \"Selected district: All · Oder-Spree, the highest rate, is highlighted\", \"Selected: \" & districtName & \" · \" & FORMAT(CALCULATE([Registered points], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"#,0\") & \" points · \" & FORMAT(CALCULATE([Registered rate], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0.0\") & \" per 10,000 · rank \" & FORMAT(CALCULATE([Registered rank], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0\") & \" of 18\")"
            ],
            "lineageTag": "5a19830a-806a-4d67-9b1f-93a3661c8062"
          },
          {
            "name": "Selected district spread",
            "expression": [
              "VAR code = [Selected district code]",
              "VAR districtName = SELECTEDVALUE('District selector'[District])",
              "VAR r = CALCULATE([Registered rate], REMOVEFILTERS(bi_district), bi_district[district_code] = code)",
              "RETURN IF(ISBLANK(code), \"Selected district: All · the image is a fixed snapshot of all 18 districts\", \"Selected: \" & districtName & \" · \" & FORMAT(r, \"0.0\") & \" per 10,000 · rank \" & FORMAT(CALCULATE([Registered rank], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0\") & \" of 18 · \" & SWITCH(TRUE(), r > 30.203519511979543, \"outlier above the box\", r > 21.469883377948214, \"above Q3 21.5\", r >= 18.299526705810475, \"between median 18.3 and Q3\", r >= 15.647459288593996, \"between Q1 15.6 and median\", r >= 6.913823154562669, \"below Q1 15.6\", \"outlier below the box\") & \" · the fixed image does not change\")"
            ],
            "lineageTag": "14a91238-cd07-4436-9705-861a60bc4881"
          },
          {
            "name": "Selected district test",
            "expression": [
              "VAR code = [Selected district code]",
              "VAR districtName = SELECTEDVALUE('District selector'[District])",
              "VAR p = CALCULATE([Registered points], REMOVEFILTERS(bi_district), bi_district[district_code] = code)",
              "VAR ph = CALCULATE([Hypothetical points], REMOVEFILTERS(bi_district), bi_district[district_code] = code)",
              "RETURN SWITCH(TRUE(), ISBLANK(code), \"Selected district: All · exclusion stays fixed to Oder-Spree; baseline unchanged\", code = \"12067\", \"Selected: Oder-Spree, the subject of this page\", \"Selected: \" & districtName & \" · \" & IF(p = ph, \"same \" & FORMAT(p, \"#,0\") & \" points in both versions (none excluded)\", FORMAT(p, \"#,0\") & \" → \" & FORMAT(ph, \"#,0\") & \" points\") & \" · rank \" & FORMAT(CALCULATE([Registered rank], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0\") & \" → \" & FORMAT(CALCULATE([Hypothetical rank], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0\") & \" of 18 · unresolved location: \" & FORMAT(CALCULATE([Unresolved known points], REMOVEFILTERS(bi_district), bi_district[district_code] = code, REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\"), \"#,0\") & \" points\")"
            ],
            "lineageTag": "ee5fbb2f-d174-4813-8e04-cbd6d7f921e9"
          },
          {
            "name": "Selected district installations",
            "expression": [
              "VAR code = [Selected district code]",
              "VAR districtName = SELECTEDVALUE('District selector'[District])",
              "RETURN IF(ISBLANK(code), \"Selected district: All · the Total row covers all 18 districts\", \"Selected: \" & districtName & \" · \" & FORMAT(CALCULATE([Registered installations], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"#,0\") & \" installations · \" & FORMAT(CALCULATE([Registered points], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"#,0\") & \" points · \" & FORMAT(CALCULATE([Registered capacity MW], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0.0\") & \" MW · \" & FORMAT(CALCULATE([Registered points per installation], REMOVEFILTERS(bi_district), bi_district[district_code] = code), \"0.00\") & \" points per installation\")"
            ],
            "lineageTag": "d79ca0d9-f0ef-4b2d-8819-1a72574f8888"
          }
        ],
        "partitions": [
          {
            "name": "bi_scenario",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(BundlePath & \"\\bi_scenario.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumns(Nulls, {{\"scenario_id\", (value) => value, type text}, {\"scenario_label\", (value) => value, type text}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
