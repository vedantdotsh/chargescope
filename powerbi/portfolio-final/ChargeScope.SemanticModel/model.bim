    "tables": [
      {
        "name": "bi_district",
        "columns": [
          {
            "name": "district_code",
            "dataType": "string",
            "lineageTag": "05b2b5ea-ef4a-4ad9-b921-f46089fae98b",
            "sourceColumn": "district_code",
            "summarizeBy": "none"
          },
          {
            "name": "district_name",
            "dataType": "string",
            "lineageTag": "eaa7ccb5-6673-43de-9a10-9f0c2ba5027c",
            "sourceColumn": "district_name",
            "summarizeBy": "none"
          },
          {
            "name": "district_class",
            "dataType": "string",
            "lineageTag": "0e2abfcb-5291-4d93-aba1-218390bc4204",
            "sourceColumn": "district_class",
            "summarizeBy": "none"
          },
          {
            "name": "peer_group",
            "dataType": "string",
            "lineageTag": "be24815a-2c1a-410a-a7b4-76ca6e21560b",
            "sourceColumn": "peer_group",
            "summarizeBy": "none"
          },
          {
            "name": "ibz",
            "dataType": "string",
            "lineageTag": "d410c799-dc78-4fd0-8955-d7486009d757",
            "sourceColumn": "ibz",
            "summarizeBy": "none"
          },
          {
            "name": "boundary_vintage",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "f3f914cf-2a74-45be-a536-4b5305aa885a",
            "sourceColumn": "boundary_vintage",
            "summarizeBy": "none"
          },
          {
            "name": "boundary_crs",
            "dataType": "string",
            "lineageTag": "d2b97980-e051-4b91-9b2b-6fb58d358eb6",
            "sourceColumn": "boundary_crs",
            "summarizeBy": "none"
          },
          {
            "name": "population",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "bcdc0c91-f813-4d09-b508-42e8b9781c94",
            "sourceColumn": "population",
            "summarizeBy": "none"
          },
          {
            "name": "population_date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "cc48aaaf-08e0-4125-bacf-d76ec6c56897",
            "sourceColumn": "population_date",
            "summarizeBy": "none"
          },
          {
            "name": "cadastral_area_km2",
            "dataType": "double",
            "isHidden": true,
            "lineageTag": "f1cc8047-c982-44f3-94fb-9c2b2c59dba8",
            "sourceColumn": "cadastral_area_km2",
            "summarizeBy": "none"
          },
          {
            "name": "area_source",
            "dataType": "string",
            "lineageTag": "faf35ddd-b10b-44e0-b767-01201b4e39fa",
            "sourceColumn": "area_source",
            "summarizeBy": "none"
          },
          {
            "name": "population_source",
            "dataType": "string",
            "lineageTag": "b7516b62-9181-42e5-bbdc-a12c2890a743",
            "sourceColumn": "population_source",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "d577c769-fdae-4091-ad2f-0a06fe217da4",
        "partitions": [
          {
            "name": "bi_district",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(BundlePath & \"\\bi_district.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumns(Nulls, {{\"district_code\", (value) => value, type text}, {\"district_name\", (value) => value, type text}, {\"district_class\", (value) => value, type text}, {\"peer_group\", (value) => value, type text}, {\"ibz\", (value) => value, type text}, {\"boundary_vintage\", (value) => if value = null then null else Date.FromText(value, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"]), type date}, {\"boundary_crs\", (value) => value, type text}, {\"population\", (value) => if value = null then null else Number.FromText(value, \"en-US\"), Int64.Type}, {\"population_date\", (value) => if value = null then null else Date.FromText(value, [Format=\"yyyy-MM-dd\", Culture=\"en-US\"]), type date}, {\"cadastral_area_km2\", (value) => if value = null then null else Number.FromText(value, \"en-US\"), type number}, {\"area_source\", (value) => value, type text}, {\"population_source\", (value) => value, type text}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "bi_scenario",
        "columns": [
          {
            "name": "scenario_id",
            "dataType": "string",
            "lineageTag": "772dadcb-8020-4fe9-9b17-1a40a951e2c7",
            "sourceColumn": "scenario_id",
            "summarizeBy": "none"
          },
          {
            "name": "scenario_label",
            "dataType": "string",
            "lineageTag": "95718aca-225b-4776-b406-24937ae827db",
            "sourceColumn": "scenario_label",
            "summarizeBy": "none"
          },
          {
            "name": "scenario_short",
            "dataType": "string",
            "expression": "IF(bi_scenario[scenario_id] = \"registered\", \"Registered baseline\", \"Hypothetical exclusion\")",
            "isDataTypeInferred": true,
            "lineageTag": "be1de9c7-dd43-4983-8333-7dc79a0ce3d1",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "2ee84f02-488a-4e31-913b-b13964aecd2f",
        "measures": [
          {
            "name": "Registered or Scenario Points",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]) && SUM(bi_district_scenario[unknown_point_installations]) = 0, SUM(bi_district_scenario[points]))",
            "formatString": "#,0",
            "lineageTag": "6eaa61b3-2453-4500-945e-9dea43f12f7b"
          },
          {
            "name": "Population",
            "expression": "IF(COUNTROWS(FILTER(bi_district, ISBLANK(bi_district[population]) || bi_district[population] <= 0)) = 0, SUM(bi_district[population]))",
            "formatString": "#,0",
            "lineageTag": "34fe0d7a-a96c-4511-9aa5-8049b3e45ac6"
          },
          {
            "name": "Points per 10000 Residents",
            "expression": "DIVIDE(10000 * [Registered or Scenario Points], [Population])",
            "formatString": "0.0000",
            "lineageTag": "cc1a1f6c-15ba-40ff-8740-258369f89e6d"
          },
          {
            "name": "Installation kW",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]) && SUM(bi_district_scenario[nominal_kw_missing_n]) = 0, SUM(bi_district_scenario[nominal_kw]))",
            "formatString": "#,0.0",
            "lineageTag": "5df15206-02eb-4cd1-94a2-05a89844c983"
          },
          {
            "name": "Installations",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[installations]))",
            "formatString": "#,0",
            "lineageTag": "aa176a81-b37a-410a-872d-2bf0a30a426f"
          },
          {
            "name": "Agreement-only known points",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[agreed_known_points]))",
            "formatString": "#,0",
            "lineageTag": "32f319ac-632a-4475-aa4a-041529d9b339"
          },
          {
            "name": "Unresolved installations",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[unresolved_installations]))",
            "formatString": "#,0",
            "lineageTag": "f215dacd-984e-40f4-b500-6afc8afa304b"
          },
          {
            "name": "Unresolved known points",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[known_points]) - SUM(bi_district_scenario[agreed_known_points]))",
            "formatString": "#,0",
            "lineageTag": "1bf32b62-cd5f-42fb-aeec-b5e9d320e158"
          },
          {
            "name": "Known points subtotal",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[known_points]))",
            "formatString": "#,0",
            "lineageTag": "3bed453b-c4da-45af-8010-a84e386cdca9"
          },
          {
            "name": "Unknown point installations",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[unknown_point_installations]))",
            "formatString": "#,0",
            "lineageTag": "aeeb198b-c03c-4d0f-82b3-f0ebd69a44e3"
          },
          {
            "name": "Missing kW installations",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), SUM(bi_district_scenario[nominal_kw_missing_n]))",
            "formatString": "#,0",
            "lineageTag": "520cfe21-e206-4a3d-a83e-dcc6a5ebcd0a"
          },
          {
            "name": "Brandenburg-wide snapshot rank",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]) && HASONEVALUE(bi_district[district_code]), MAX(bi_district_scenario[brandenburg_rank]))",
            "formatString": "0",
            "lineageTag": "03989d44-072e-48ed-b0d8-f28d8bb99f1b"
          },
          {
            "name": "Scenario status",
            "expression": "IF(HASONEVALUE(bi_scenario[scenario_id]), IF(SELECTEDVALUE(bi_scenario[scenario_id]) = \"registered\", \"REGISTERED baseline | group retained\", \"HYPOTHETICAL exclusion | access unverified\"), \"SELECT EXACTLY ONE SCENARIO | totals suppressed\")",
            "lineageTag": "45f402a7-cb7d-42c7-aff1-5bf8609a56ae"
          },
          {
            "name": "Baseline installation kW",
            "expression": "IF(COUNTROWS(FILTER(bi_installation, ISBLANK(bi_installation[nominal_kw]))) = 0, SUM(bi_installation[nominal_kw]))",
            "formatString": "#,0.0",
            "lineageTag": "94fecefb-cee8-4469-8241-f41cd78cb3e3"
          },
          {
            "name": "Registered points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "#,0",
            "lineageTag": "e5c9c249-7a48-4531-bb66-db1d2ac86737"
          },
          {
            "name": "Registered rank",
            "expression": "CALCULATE([Brandenburg-wide snapshot rank], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "#,0",
            "lineageTag": "8fc3cdb4-95fa-4484-a4fc-6638969a4d2a"
          },
          {
            "name": "Registered rate",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\")",
            "formatString": "0.0000",
            "lineageTag": "6de640c3-0222-4e5f-bba9-af23deb6c853"
          },
          {
            "name": "Hypothetical points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\")",
            "formatString": "#,0",
            "lineageTag": "bdda7b9d-36bf-42d6-b24b-7c2ffeb0dadf"
          },
          {
            "name": "Hypothetical rank",
            "expression": "CALCULATE([Brandenburg-wide snapshot rank], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\")",
            "formatString": "#,0",
            "lineageTag": "027b80a3-d30b-49db-8ec0-b7ac4d26d392"
          },
          {
            "name": "Hypothetical rate",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"hypothetical_exclusion\")",
            "formatString": "0.0000",
            "lineageTag": "d555fedd-37e1-495d-ad97-c6cbd4c67214"
          },
          {
            "name": "Berlin Registered or Scenario Points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_district), bi_district[district_code] = \"11000\")",
            "formatString": "#,0",
            "lineageTag": "a4872648-214d-4c82-8e01-62314980b0e9"
          },
          {
            "name": "Berlin Population",
            "expression": "CALCULATE([Population], REMOVEFILTERS(bi_district), bi_district[district_code] = \"11000\")",
            "formatString": "#,0",
            "lineageTag": "06f15d74-1605-4cfb-b933-8b92a4e1a92d"
          },
          {
            "name": "Berlin Points per 10000 Residents",
            "expression": "CALCULATE([Points per 10000 Residents], REMOVEFILTERS(bi_district), bi_district[district_code] = \"11000\")",
            "formatString": "0.0000",
            "lineageTag": "16662356-8ccc-4ca2-8d03-112dff9210cd"
          },
          {
            "name": "Brandenburg fixed registered points",
            "expression": "CALCULATE([Registered or Scenario Points], REMOVEFILTERS(bi_district), REMOVEFILTERS(bi_scenario), bi_scenario[scenario_id] = \"registered\", bi_district[district_class] IN {\"kreisfreie_stadt\", \"landkreis\"})",
            "formatString": "#,0",
